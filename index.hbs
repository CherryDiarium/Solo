{{!< default}}

<section class="gh-about gh-outer{{#match @custom.header_section_layout "!=" "Typographic profile"}}{{#unless @site.cover_image}} no-image{{/unless}}{{else}}{{#unless @site.icon}} no-image{{/unless}}{{/match}}{{#if @custom.use_dark_mode_cover}}{{#if @custom.dark_mode_cover_image}} has-dark-cover{{/if}}{{/if}}"
    data-idle-timeout="{{@custom.cover_idle_timeout}}">
    <div class="gh-about-inner gh-inner">
        {{#match @custom.header_section_layout "!=" "Typographic profile"}}
            {{#match @custom.header_section_layout "=" "Large background"}}
                {{#if @site.cover_image}}
                    <img class="gh-about-image gh-about-image-light" crossorigin="anonymous"
                        src="{{@site.cover_image}}" alt="{{@site.title}}">
                {{/if}}
                {{#if @custom.use_dark_mode_cover}}
                    {{#if @custom.dark_mode_cover_image}}
                        <img class="gh-about-image gh-about-image-dark" crossorigin="anonymous"
                            src="{{@custom.dark_mode_cover_image}}" alt="{{@site.title}}">
                    {{/if}}
                {{/if}}
            {{else}}
                {{#if @site.cover_image}}
                    <img class="gh-about-image gh-about-image-light" crossorigin="anonymous"
                        srcset="{{img_url @site.cover_image size="s"}} 300w,
                            {{img_url @site.cover_image size="m"}} 720w"
                        sizes="(max-width: 720px) 100vw, 50vw"
                        src="{{@site.cover_image}}" alt="{{@site.title}}">
                {{/if}}
                {{#if @custom.use_dark_mode_cover}}
                    {{#if @custom.dark_mode_cover_image}}
                        <img class="gh-about-image gh-about-image-dark" crossorigin="anonymous"
                            srcset="{{img_url @custom.dark_mode_cover_image size="s"}} 300w,
                                {{img_url @custom.dark_mode_cover_image size="m"}} 720w"
                            sizes="(max-width: 720px) 100vw, 50vw"
                            src="{{@custom.dark_mode_cover_image}}" alt="{{@site.title}}">
                    {{/if}}
                {{/if}}
            {{/match}}
        {{else}}
            {{#if @site.icon}}
                <img class="gh-about-image" src="{{@site.icon}}" alt="{{@site.title}}">
            {{/if}}
        {{/match}}
        <script>
            (function () {
                if (!document.body.classList.contains('has-background-about')) return;

                const about = document.querySelector('.gh-about');
                if (!about) return;

                const isDarkMode = document.documentElement.classList.contains('is-dark-mode');
                const isLightMode = document.documentElement.classList.contains('is-light-mode');
                const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                const actuallyDarkMode = isDarkMode || (!isLightMode && prefersDark);
                
                const hasDarkCover = about.classList.contains('has-dark-cover');
                let imageSelector = '.gh-about-image';
                if (actuallyDarkMode && hasDarkCover) {
                    imageSelector = '.gh-about-image-dark';
                } else if (hasDarkCover) {
                    imageSelector = '.gh-about-image-light';
                }
                const image = about.querySelector(imageSelector);

                const initCover = () => {
                    about.classList.add('initialized');
                };

                if (image) {
                    if (image.complete) {
                        setTimeout(initCover, 50);
                    } else {
                        image.addEventListener('load', initCover);
                    }
                    const checkBrightness = () => {
                        const canvas = document.createElement('canvas');
                        canvas.width = 100;
                        canvas.height = 100;
                        const ctx = canvas.getContext('2d');
                        try {
                            ctx.drawImage(image, 0, 0, 100, 100);
                            const data = ctx.getImageData(0, 0, 100, 100).data;
                            let r = 0, g = 0, b = 0;
                            const pixels = data.length / 4;
                            for (let i = 0; i < data.length; i += 4) {
                                r += data[i];
                                g += data[i + 1];
                                b += data[i + 2];
                            }
                            r = Math.floor(r / pixels);
                            g = Math.floor(g / pixels);
                            b = Math.floor(b / pixels);
                            const yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
                            if (yiq >= 128) {
                                document.body.classList.add('is-light-bg');
                            }
                        } catch (e) {
                            console.warn('Could not calculate cover image brightness:', e);
                        }
                    };

                    if (image.complete) {
                        checkBrightness();
                    } else {
                        image.addEventListener('load', checkBrightness);
                    }
                }
            })();
        </script>
        <div class="gh-about-content">
            <div class="gh-about-content-inner">
                {{#if @custom.primary_header}}
                    <h1 class="gh-about-primary">{{{@custom.primary_header}}}</h1>
                {{/if}}
                {{#if @custom.secondary_header}}
                    <p class="gh-about-secondary">{{{@custom.secondary_header}}}</p>
                {{/if}}
            </div>
        </div>
        {{#match @custom.header_section_layout "=" "Large background"}}
        <button class="cover-arrow" id="dismiss-cover">{{> "icons/caret-down"}}</button>
        {{/match}}
    </div>
</section>

<main id="content" class="gh-main gh-outer">
    <div class="gh-feed gh-inner">
        {{#if @custom.show_restricted_posts}}
            {{#foreach posts}}
                {{^has tag="#hidden"}}
                    {{> "loop"}}
                {{/has}}
            {{/foreach}}
        {{else}}
            {{#foreach posts visibility="public"}}
                {{^has tag="#hidden"}}
                    {{> "loop"}}
                {{/has}}
            {{/foreach}}
        {{/if}}
    </div>
</main>

{{#contentFor "body_class"}}{{#match @custom.header_section_layout "Side by side"}} has-side-about{{/match}}{{#match @custom.header_section_layout "Large background"}}{{#if @site.cover_image}} is-head-transparent has-background-about{{else}} has-side-about{{/if}}{{/match}}{{#match @custom.header_section_layout "Typographic profile"}}{{#if @site.icon}} has-typographic-about{{else}} has-side-about{{/if}}{{/match}}{{#if @custom.cover_text_shadow}} has-cover-shadow{{/if}}{{/contentFor}}
