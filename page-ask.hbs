{{!< default}}
{{!-- Auto-bound template for the page with slug "ask" (path /ask). --}}

{{#contentFor "body_class"}} ai-chat-page{{/contentFor}}

<main class="gh-main gh-outer ai-chat-main">

    {{!-- Full-width scroller so its scrollbar sits at the screen's right edge;
          inner column keeps the conversation centered at the content width. --}}
    <div class="ai-chat-scroll" id="ai-chat-scroll">
        <div class="ai-chat-col">
            <div class="ai-chat-welcome" id="ai-chat-welcome">
                <p class="ai-chat-greeting" id="ai-chat-greeting">Hi, how can I help?</p>
                <p class="ai-chat-disclaimer">AI can make mistakes. Double-check important info.</p>
            </div>
            <div class="ai-chat-messages" id="ai-chat-messages" aria-live="polite"></div>
        </div>
    </div>

    {{!-- Set the agent endpoint here, or override site-wide via Ghost code
          injection: <script>window.SOLORIUM_AGENT_URL = "https://…/chat"</script> --}}
    <form class="ai-chat-form" id="ai-chat-form" data-endpoint="https://agent.quangmn.com/chat">
        <div class="ai-chat-col">
            <div class="ai-chat-input-wrap">
                {{!-- Row 1: expanding textarea --}}
                <textarea
                    class="ai-chat-input"
                    id="ai-chat-input"
                    rows="1"
                    placeholder="Ask about {{@site.title}}…"
                    aria-label="Ask the assistant a question"
                    autocomplete="off"
                ></textarea>
                {{!-- Row 2: model picker (left) + context ring + send button (right) --}}
                <div class="ai-chat-toolbar">
                    {{!-- Model selector dropdown --}}
                    <div class="ai-chat-model-wrap" id="ai-chat-model-wrap">
                        <select class="ai-chat-model-select" id="ai-chat-model-select" aria-label="Select AI model">
                            <option value="" disabled selected>No model available</option>
                        </select>
                        {{!-- Rate-limit warning icon (hidden by default) --}}
                        <span class="ai-chat-model-warn" id="ai-chat-model-warn" aria-hidden="true" title="Model is unavailable">
                            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M10 6v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <circle cx="10" cy="13.5" r="0.75" fill="currentColor"/>
                            </svg>
                        </span>
                    </div>
                    {{!-- Right controls: context ring + send --}}
                    <div class="ai-chat-actions">
                        {{!-- Context window usage ring --}}
                        <div class="ai-chat-ctx-ring" id="ai-chat-ctx-ring" aria-label="Context window usage" title="0 / 0 tokens used (0%)">
                            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                {{!-- Track --}}
                                <circle cx="18" cy="18" r="14" stroke="currentColor" stroke-width="2.5" class="ctx-track"/>
                                {{!-- Fill arc — stroke-dashoffset animated in JS --}}
                                <circle cx="18" cy="18" r="14" stroke="currentColor" stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-dasharray="87.96"
                                    stroke-dashoffset="87.96"
                                    class="ctx-fill"
                                    transform="rotate(-90 18 18)"/>
                            </svg>
                        </div>
                        <button type="submit" class="ai-chat-send" id="ai-chat-send" aria-label="Send message" disabled>
                            {{> "icons/arrow-up"}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>


</main>

{{#contentFor "scripts"}}
<script type="module" src="{{asset "js/chat.js"}}"></script>
{{/contentFor}}
